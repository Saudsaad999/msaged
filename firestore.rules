rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // بيانات المنظومة: للمستخدمين المسجّلين فقط (الدخول المجهول من الموقع)
    match /zulfi_state/{doc} {
      allow read, write: if request.auth != null;
    }
    // أي شيء آخر مغلق
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
